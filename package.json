{
  "name": "creatorutils-broll-matcher",
  "version": "1.0.0",
  "description": "AI B-Roll Matcher for Content Creators - Inspired by Duy Luan's CreatorUtils",
  "author": "CreatorUtils",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --host --strictPort",
    "start": "node scripts/start_all.mjs",
    "api": "node scripts/run_python.mjs -m engine.api_server",
    "build": "vite build",
    "preview": "vite preview",
    "test:js": "node --test tests/*.test.mjs",
    "test:py": "node scripts/run_python.mjs -m unittest discover -s tests -v",
    "test:compile": "node scripts/run_python.mjs -m compileall -q engine tests",
    "test": "node scripts/test_all.mjs",
    "doctor": "node scripts/run_python.mjs scripts/doctor.py",
    "desktop:dev": "node scripts/start_desktop.mjs",
    "desktop:build-engine": "powershell -ExecutionPolicy Bypass -File scripts/build_engine.ps1",
    "desktop:dist": "node scripts/build_desktop.mjs"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "vite": "^6.2.0"
  }
}
