# Backend chỉ nên bind localhost nếu chưa có authentication/TLS.
CREATORUTILS_API_HOST=127.0.0.1
CREATORUTILS_API_PORT=8765
CREATORUTILS_MAX_UPLOAD_MB=4096

# Chỉ thêm khi frontend thật sự được mở từ một máy khác trong LAN.
# CREATORUTILS_ALLOWED_ORIGINS=http://192.168.1.20:5173

# Có thể bỏ trống và nhập key trong giao diện; key giao diện chỉ giữ trong RAM.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Tùy chọn: đổi nơi lưu creatorutils.db.
# CREATORUTILS_DATA_DIR=D:\CreatorUtilsData
